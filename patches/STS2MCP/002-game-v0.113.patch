diff --git a/McpMod.MerchantCompatibility.cs b/McpMod.MerchantCompatibility.cs
new file mode 100644
index 0000000..1553f98
--- /dev/null
+++ b/McpMod.MerchantCompatibility.cs
@@ -0,0 +1,27 @@
+using System.Threading.Tasks;
+using MegaCrit.Sts2.Core.Entities.Merchant;
+using MegaCrit.Sts2.Core.Rooms;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2_MCP;
+
+public static partial class McpMod
+{
+    private static MerchantInventory? GetLocalMerchantInventory(MerchantRoom room)
+    {
+#if STS2_API_113
+        return RunManager.Instance.MerchantSynchronizer.GetLocalInventory();
+#else
+        return room.GetLocalInventory();
+#endif
+    }
+
+    private static Task<bool> PurchaseMerchantEntry(MerchantEntry entry, MerchantInventory inventory)
+    {
+#if STS2_API_113
+        return RunManager.Instance.MerchantSynchronizer.PurchaseLocalEntry(entry);
+#else
+        return entry.OnTryPurchaseWrapper(inventory);
+#endif
+    }
+}
