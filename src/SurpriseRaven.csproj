<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RitsuLibAutoCopy>false</RitsuLibAutoCopy>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.4.6</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.4.6.0</AssemblyVersion>
    <FileVersion>0.4.6.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(RavenSourceCommit)' != ''">
    <AssemblyMetadata Include="RavenSourceCommit" Value="$(RavenSourceCommit)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Config/gameplay-odds.json" LogicalName="SurpriseRaven.Config.gameplay-odds.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="STS2.RitsuLib.Compat.0.111.0" Version="[0.6.14]" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Use the actual game assembly below instead of the transitive package. -->
    <PackageReference Include="GodotSharp" Version="[4.5.1]" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>..\references\0.111.0\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\references\0.111.0\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>..\references\0.111.0\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>



