# Local paths only; copy to .env and replace these placeholders.
# The target game must be 0.111.0 or 0.113.1.
GAME_DIR=C:\path\to\target-game
# The shared main DLL always compiles against game 0.111.0.
BASELINE_GAME_DIR=C:\path\to\game-0.111.0
# Complete Workshop RitsuLib 0.6.14 bundle, including shared/, compat/ and assets.zip.
RITSULIB_DIR=C:\path\to\ritsulib-workshop
# Optional local Raven media source override.
# RAVEN_ASSETS_DIR=C:\path\to\raven-media
